# =========================================================================
# CONFIGURAÇÕES DE AMBIENTE: SLOWSOCIAL PRODUÇÃO / LOCAL
# =========================================================================

# Servidor HTTP & Gateway
PORT=8080
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Banco de Dados PostgreSQL 16
DATABASE_URL=postgres://postgres:postgres@localhost:5432/slowsocial?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Cache Redis 7
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# Apache Kafka (KRaft mode)
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=slowsocial-group

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=super-secret-supabase-jwt-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Armazenamento S3 (MinIO Local ou AWS S3 / Cloudflare R2 em Produção)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=slowsocial-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
CDN_BASE_URL=http://localhost:9000/slowsocial-media

# OpenTelemetry & Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=your-firebase-server-key
